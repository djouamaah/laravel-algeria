{
    "name": "djouamaah/laravel-algeria",
    "description": "All Algerian wilayas, dairas, communes and postal codes (69 wilayas / 1541 communes) for Laravel: migrations, seeder, Eloquent models, validation rules and a ready-made API.",
    "keywords": ["laravel", "algeria", "algerie", "الجزائر", "wilaya", "daira", "commune", "baladiya", "postal code", "code postal"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Djouamaa",
            "email": "djouamaah@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Djouamaah\\Algeria\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Djouamaah\\Algeria\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Djouamaah\\Algeria\\AlgeriaServiceProvider"
            ],
            "aliases": {
                "Algeria": "Djouamaah\\Algeria\\Facades\\Algeria"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
